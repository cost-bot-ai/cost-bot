# Copy to `.env` in this folder on the Unraid box (cp env.example .env; chmod 600 .env).
# `.env` is git-ignored. Do not paste any of these values into chat, issues or the repo.

# Your Proton WireGuard private key (account.proton.me -> VPN -> WireGuard). A 32-byte base64 string.
WIREGUARD_PRIVATE_KEY=CHANGE_ME

# Your real public IP address with the VPN OFF (e.g. from your router's status page). Used only to confirm
# the container's traffic does NOT leave from it. Never printed, never written to the output files.
HOME_IP=CHANGE_ME

# One fixed country for the VPN exit. Choose once; do not change it to get past a block.
SERVER_COUNTRIES=United States

# After the first pull, pin the image by digest (RUNBOOK step 4), e.g. qmcgaw/gluetun@sha256:...
GLUETUN_IMAGE=qmcgaw/gluetun

# Pages to read (the script has a hard ceiling of 25) and the sampling seed.
N_PAGES=20
SEED=7
